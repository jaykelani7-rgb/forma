# Use the HTTPS URL of the published, signed, notarized Apple silicon DMG.
FORMA_MAC_DOWNLOAD_URL=

# Public Formspree URL for Windows waitlist submissions (https://formspree.io/f/...).
FORMA_WINDOWS_WAITLIST_URL=

# Origin of the existing web notebook. Leave unset to omit notebook links in production.
# Development defaults to http://localhost:3001.
# FORMA_NOTEBOOK_ORIGIN=https://notebook.example.com
