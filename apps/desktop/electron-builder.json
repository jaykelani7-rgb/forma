{
  "appId": "app.forma.companion",
  "productName": "Forma Companion",
  "electronVersion": "44.9.0",
  "asar": true,
  "directories": {
    "output": "../dist/companion",
    "buildResources": "../packages/ribbon"
  },
  "files": [
    "main.cjs",
    "database-worker.cjs",
    "preload.cjs",
    "renderer/**/*",
    "assets/**/*",
    "package.json"
  ],
  "mac": {
    "icon": "ribbon-icon.png",
    "target": [
      {
        "target": "dir",
        "arch": [
          "arm64"
        ]
      }
    ],
    "category": "public.app-category.education",
    "identity": null,
    "extendInfo": {
      "NSMicrophoneUsageDescription": "Record a voice question only when you choose the microphone. Review its transcript before sending to Forma Tutor."
    }
  },
  "win": {
    "target": [
      "dir"
    ]
  },
  "linux": {
    "target": [
      "dir"
    ]
  }
}
