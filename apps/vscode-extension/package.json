{
  "name": "forma-companion",
  "displayName": "Forma Companion",
  "description": "A local, paired connection between VS Code and Forma Companion.",
  "publisher": "forma",
  "version": "0.3.0",
  "private": true,
  "engines": {
    "vscode": "^1.95.0"
  },
  "categories": [
    "Other"
  ],
  "extensionKind": [
    "ui"
  ],
  "main": "./dist/extension.js",
  "activationEvents": [
    "onStartupFinished"
  ],
  "capabilities": {
    "untrustedWorkspaces": {
      "supported": "limited",
      "description": "Status remains available. Pairing, file association, queued delivery, and CPH access require a trusted, explicitly selected local folder."
    },
    "virtualWorkspaces": {
      "supported": false,
      "description": "Only local file workspaces are supported."
    }
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "vscode:prepublish": "npm run build"
  },
  "contributes": {
    "commands": [
      {
        "command": "formaCompanion.pair",
        "title": "Forma: Pair with Companion"
      },
      {
        "command": "formaCompanion.unpair",
        "title": "Forma: Remove Pairing"
      },
      {
        "command": "formaCompanion.selectFolders",
        "title": "Forma: Select Allowed Folders"
      },
      {
        "command": "formaCompanion.attachProblem",
        "title": "Forma: Attach Codeforces Problem"
      },
      {
        "command": "formaCompanion.open",
        "title": "Forma: Open Companion"
      },
      {
        "command": "formaCompanion.askSelectedCode",
        "title": "Forma: Ask About Selected Code"
      },
      {
        "command": "formaCompanion.saveThought",
        "title": "Forma: Save Thought"
      },
      {
        "command": "formaCompanion.start",
        "title": "Forma: Start Session"
      },
      {
        "command": "formaCompanion.pause",
        "title": "Forma: Pause Session"
      },
      {
        "command": "formaCompanion.resume",
        "title": "Forma: Resume Session"
      },
      {
        "command": "formaCompanion.finish",
        "title": "Forma: Finish and Reflect"
      },
      {
        "command": "formaCompanion.memory",
        "title": "Forma: Open Prior Memory"
      },
      {
        "command": "formaCompanion.runCphTests",
        "title": "Forma: Run CPH Tests"
      },
      {
        "command": "formaCompanion.retry",
        "title": "Forma: Retry Pending Captures"
      },
      {
        "command": "formaCompanion.exportQueue",
        "title": "Forma: Export Pending Captures for Recovery"
      },
      {
        "command": "formaCompanion.setup",
        "title": "Forma: Setup and Connection"
      },
      {
        "command": "formaCompanion.recognition",
        "title": "Forma: Recognise Problems from CPH"
      },
      {
        "command": "formaCompanion.forget",
        "title": "Forma: Forget This File Association"
      },
      {
        "command": "formaCompanion.useCph",
        "title": "Forma: Rebind This File from CPH"
      }
    ],
    "configuration": {
      "title": "Forma Companion",
      "properties": {
        "formaCompanion.developmentLaunchPath": {
          "type": "string",
          "default": "",
          "description": "Optional trusted absolute path to a Forma Companion.app or self-contained executable development launcher on this Mac. Read only from User Settings; workspace values and shell arguments are never executed. Leave empty to use /Applications/Forma Companion.app, then ~/Applications/Forma Companion.app.",
          "scope": "machine"
        },
        "formaCompanion.cphMetadataEnabled": {
          "type": "boolean",
          "default": false,
          "description": "Recognise problems from supported CPH metadata for the active permitted solution. Explicit consent; no source reading, automatic timer, or test-result claims.",
          "scope": "machine"
        }
      }
    }
  }
}
