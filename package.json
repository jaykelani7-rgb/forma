{
  "name": "forma-practice",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "next dev --hostname 0.0.0.0 --port 3001",
    "build": "next build",
    "start": "next start --hostname 0.0.0.0",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "node --import tsx --test tests/*.test.ts",
    "test:browser": "playwright test",
    "test:share-links": "node scripts/test-share-links.mjs",
    "prepare:imports": "node scripts/prepare-import-assets.mjs",
    "postinstall": "npm run prepare:imports",
    "prebuild": "npm run prepare:imports",
    "predev": "npm run prepare:imports",
    "companion:build": "node scripts/companion/build.mjs",
    "companion:dev": "npm run companion:build && node scripts/companion/start.mjs",
    "companion:start": "node scripts/companion/start.mjs",
    "companion:preview": "vite --config apps/desktop/vite.config.mjs",
    "companion:package": "npm run companion:build && electron-builder --projectDir .companion-build --config ../apps/desktop/electron-builder.json --dir --mac --arm64",
    "extension:build": "node scripts/companion/build-extension.mjs",
    "companion:verify": "node scripts/companion/verify-native.mjs",
    "browser:build": "node scripts/browser/build.mjs",
    "browser:install": "node scripts/browser/install.mjs",
    "browser:uninstall": "node scripts/browser/uninstall.mjs",
    "extension:verify": "node --import tsx scripts/companion/verify-vscode-recognition.ts"
  },
  "dependencies": {
    "@supabase/supabase-js": "2.117.2",
    "@tesseract.js-data/eng": "1.0.0",
    "fast-xml-parser": "5.11.2",
    "fflate": "0.8.3",
    "lucide-react": "^0.468.0",
    "next": "^16.1.0",
    "pdfjs-dist": "6.4.299",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "tesseract.js": "7.0.0",
    "tesseract.js-core": "7.0.0"
  },
  "devDependencies": {
    "@electric-sql/pglite": "0.5.8",
    "@playwright/test": "^1.63.0",
    "@tailwindcss/postcss": "^4.1.0",
    "@types/node": "^24.0.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@types/vscode": "1.95.0",
    "electron": "44.9.0",
    "electron-builder": "26.15.3",
    "esbuild": "0.28.2",
    "eslint": "^9.0.0",
    "eslint-config-next": "^16.1.0",
    "fake-indexeddb": "^6.2.5",
    "tailwindcss": "^4.1.0",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0",
    "vite": "8.3.4"
  }
}
