# Optional account sync. Leave unset to keep Forma fully local.
# Copy to .env.local, which is ignored by Git. Restart the dev server after editing.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Use the publishable key from Supabase Settings > API Keys.
# Never place a secret/service-role key in a NEXT_PUBLIC variable.
