# Optional account sync. Leave unset to keep Forma fully local.
# Copy to .env.local, which is ignored by Git. Restart the dev server after editing.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Use the publishable key from Supabase Settings > API Keys.
# Never place a secret/service-role key in a NEXT_PUBLIC variable.

# Optional Shared Tracks links; local file export needs no hosted configuration.
# Apply both migrations in docs/cloud-setup.md before enabling link sharing.
# Use an sb_secret_ key from Supabase Settings > API Keys, on the server only.
# Never prefix this variable with NEXT_PUBLIC_ or expose it in browser code.
# Account sync still uses the two public values above and the verified user token.
SUPABASE_SECRET_KEY=
